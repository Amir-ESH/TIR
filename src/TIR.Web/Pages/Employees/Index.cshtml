@page
@using System.Text.Json
@model TIR.Web.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "فهرست کارمندان";
}
<div class="toolbar">
    <div><h2 class="section-title mb-1">کارمندان سازمان</h2><p class="page-lead mb-0">فهرست، جستجو، ویرایش و بازیابی اطلاعات پرسنلی.</p></div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="/Employees/Index" asp-page-handler="Excel" asp-route-Search="@Model.Search" asp-route-SortBy="@Model.SortBy" asp-route-SortDescending="@Model.SortDescending" class="btn btn-outline-success">دانلود فایل خروجی کارمندان</a>
        <a asp-page="/Employees/Create" class="btn btn-primary">+ افزودن کارمند</a>
    </div>
</div>
<div class="card">
    <div class="card-body pb-0">
        <form method="get" class="filter-bar mb-3">
            <input asp-for="Search" class="form-control flex-grow-1" placeholder="کد، نام یا نام خانوادگی" />
            <select asp-for="SortBy" class="form-select"><option value="Id">شناسه</option><option value="EmployeeCode">کد کارمند</option><option value="FirstName">نام</option><option value="LastName">نام خانوادگی</option></select>
            <select asp-for="SortDescending" class="form-select"><option value="false">صعودی</option><option value="true">نزولی</option></select>
            <div class="form-check"><input asp-for="IncludeDeleted" class="form-check-input" /><label asp-for="IncludeDeleted" class="form-check-label">نمایش حذف شده ها</label></div>
            <button class="btn btn-outline-primary">اعمال فیلتر</button>
        </form>
    </div>
    <div class="table-wrap">
        <div id="employeesGrid" class="tir-data-grid" data-grid-kind="employees" data-data-id="employeesGridData" data-empty-message="کارمندی مطابق فیلتر انتخاب شده پیدا نشد."></div>
    </div>
    <script id="employeesGridData" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Result.Items.Select(item => new { item.Id, item.EmployeeCode, item.FirstName, item.LastName, item.IsDeleted })))</script>
    <div hidden>
        @foreach (var item in Model.Result.Items)
        {
            <div id="employee-actions-@item.Id">
                <a asp-page="/Employees/Details" asp-route-id="@item.Id" data-employee-details-modal="true" class="btn btn-sm btn-outline-secondary tir-icon-btn" title="جزئیات کارمند" aria-label="جزئیات کارمند"><i class="dx-icon dx-icon-eyeopen" aria-hidden="true"></i></a>
                @if (!item.IsDeleted)
                {
                    <a asp-page="/Employees/Details" asp-route-id="@item.Id" data-employee-details-modal="true" class="btn btn-sm btn-outline-primary tir-icon-btn" title="ویرایش کارمند" aria-label="ویرایش کارمند"><i class="dx-icon dx-icon-edit" aria-hidden="true"></i></a>
                    <form method="post" asp-page-handler="SoftDelete" data-confirm="آیا این کارمند و مقادیر وابسته حذف منطقی شوند؟">
                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                        <button type="submit" class="btn btn-sm btn-outline-danger tir-icon-btn" title="حذف کارمند" aria-label="حذف کارمند"><i class="dx-icon dx-icon-trash" aria-hidden="true"></i></button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Restore" data-confirm="کارمند و مقادیر قابل بازیابی او بازگردانده شوند؟">
                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                        <button type="submit" class="btn btn-sm btn-outline-success tir-icon-btn" title="بازیابی کارمند" aria-label="بازیابی کارمند"><i class="dx-icon dx-icon-restore" aria-hidden="true"></i></button>
                    </form>
                }
            </div>
        }
    </div>
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="text-muted small">تعداد کل: @Model.Result.TotalCount</span>
        <nav><ul class="pagination pagination-sm">
            @if (Model.PageNumber > 1) { <li class="page-item"><a class="page-link" asp-page="/Employees/Index" asp-route-Search="@Model.Search" asp-route-IncludeDeleted="@Model.IncludeDeleted" asp-route-SortBy="@Model.SortBy" asp-route-SortDescending="@Model.SortDescending" asp-route-PageNumber="@(Model.PageNumber - 1)">قبلی</a></li> }
            <li class="page-item active"><span class="page-link">@Model.PageNumber</span></li>
            @if (Model.PageNumber * 50L < Model.Result.TotalCount) { <li class="page-item"><a class="page-link" asp-page="/Employees/Index" asp-route-Search="@Model.Search" asp-route-IncludeDeleted="@Model.IncludeDeleted" asp-route-SortBy="@Model.SortBy" asp-route-SortDescending="@Model.SortDescending" asp-route-PageNumber="@(Model.PageNumber + 1)">بعدی</a></li> }
        </ul></nav>
    </div>
</div>
