@page
@using System.Text.Json
@model TIR.Web.Pages.Employees.CreateModel
@{
    ViewData["Title"] = "افزودن کارمند";
    var inPopup = ViewContext.HttpContext.Request.Query["popup"] == "1";
}
<section id="employeeCreateScreen" class="employee-details-screen">
    <div class="employee-details-toolbar d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
            <h2 class="section-title mb-1">افزودن کارمند</h2>
            <p class="text-muted mb-0 small">اطلاعات اصلی و مشخصه های داینامیک را تکمیل و سپس افزودن را انتخاب کنید.</p>
        </div>
        <div class="d-flex gap-2">
            <button id="employeeCreateSubmit" type="submit" form="employeeCreateForm" class="btn btn-primary px-4">افزودن</button>
            @if (!inPopup)
            {
                <a asp-page="/Employees/Index" class="btn btn-outline-secondary">بازگشت به فهرست</a>
            }
        </div>
    </div>

    <form id="employeeCreateForm" method="post">
        <input type="hidden" name="Popup" value="@(inPopup ? "true" : "false")" />
        <div class="px-3 pt-3"><partial name="_Validation" /><div id="employeeCreateMessage" role="status" aria-live="polite"></div></div>
        <div class="employee-details-layout">
            <div class="employee-details-dynamic card">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <h3 class="section-title mb-0">مشخصه های داینامیک</h3>
                    <span class="text-muted small">نوع ورودی هر مشخصه مانند صفحه جزئیات است.</span>
                </div>
                <div class="card-body p-0">
                    <div id="employeeCreateGrid" class="tir-data-grid" aria-label="مشخصه های داینامیک کارمند جدید"></div>
                </div>
            </div>

            <aside class="employee-details-static card">
                <div class="card-header"><h3 class="section-title mb-0">اطلاعات ثابت کارمند</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="EmployeeCode" class="form-label">کد پرسنلی</label>
                        <input asp-for="EmployeeCode" class="form-control" maxlength="50" placeholder="اگر خالی بماند خودکار تولید می شود" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label">نام</label>
                        <input asp-for="FirstName" class="form-control" maxlength="50" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label">نام خانوادگی</label>
                        <input asp-for="LastName" class="form-control" maxlength="50" required />
                    </div>
                </div>
            </aside>
        </div>
        <div id="employeeCreatePayload" hidden></div>
    </form>

    <script id="employeeCreateGridData" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Fields.Select(field => new { field.AttributeId, field.Code, field.Name, TypeTitle = Model.DataKindTitle(field.DataKind), field.SourceKind })))</script>
    <div id="employeeCreateFieldTemplates" hidden>
        @foreach (var field in Model.Fields)
        {
            field.Prefix = "Field";
            <div class="employee-detail-template" data-attribute-id="@field.AttributeId">
                <partial name="_Field" model="field" />
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/employee-create.js" asp-append-version="true"></script>
}
