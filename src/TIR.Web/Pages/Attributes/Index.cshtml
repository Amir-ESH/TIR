@page
@using System.Text.Json
@model TIR.Web.Pages.Attributes.IndexModel
@{
    ViewData["Title"] = "مدیریت مشخصه ها";
}
<div class="toolbar">
    <div>
        <h2 class="section-title mb-1">فهرست مشخصه های داینامیک</h2>
        <p class="page-lead mb-0">عنوان، نوع، وضعیت و ترتیب نمایش مشخصه ها را مدیریت کنید.</p>
    </div>
    <a asp-page="/Attributes/Create" data-popup-page="true" class="btn btn-primary">+ مشخصه جدید</a>
</div>
<div class="card">
    <div class="table-wrap">
        <div id="attributesGrid" class="tir-data-grid" data-grid-kind="attributes"
             data-include-deleted="@(Model.IncludeDeleted ? "true" : "false")"
             data-data-id="attributesGridData" data-empty-message="مشخصه ای مطابق فیلتر وجود ندارد."></div>
    </div>
    <script id="attributesGridData" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Result.Items.Select(item => new { item.Id, item.AttributeCode, item.Title, DataKindTitle = Model.DataKindTitle(item.DataKind), SourceKindTitle = item.SourceKind == 2 ? "فرمول" : "ورودی", item.IsRequired, item.DisplayOrder, item.IsDeleted })))</script>
    <div hidden>
        @foreach (var item in Model.Result.Items)
        {
            <div id="attribute-actions-@item.Id">
                @if (!item.IsDeleted)
                {
                    @if (item.SourceKind == 1 && item.DataKind == 8)
                    {
                        <a asp-page="/Attributes/Options" asp-route-id="@item.Id" data-popup-page="true" class="btn btn-sm btn-outline-success tir-icon-btn" title="مدیریت گزینه ها" aria-label="مدیریت گزینه ها"><i class="dx-icon dx-icon-checklist" aria-hidden="true"></i></a>
                    }
                    <a asp-page="/Attributes/Edit" asp-route-id="@item.Id" data-popup-page="true" class="btn btn-sm btn-outline-primary tir-icon-btn" title="ویرایش مشخصه" aria-label="ویرایش مشخصه"><i class="dx-icon dx-icon-edit" aria-hidden="true"></i></a>
                    <form method="post" asp-page-handler="SoftDelete" data-confirm="آیا از حذف منطقی این مشخصه مطمئن هستید؟">
                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                        <button type="submit" class="btn btn-sm btn-outline-danger tir-icon-btn" title="حذف مشخصه" aria-label="حذف مشخصه"><i class="dx-icon dx-icon-trash" aria-hidden="true"></i></button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Restore" data-confirm="مشخصه و مقدارهای وابسته بازیابی شوند؟">
                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                        <button type="submit" class="btn btn-sm btn-outline-success tir-icon-btn" title="بازیابی مشخصه" aria-label="بازیابی مشخصه"><i class="dx-icon dx-icon-restore" aria-hidden="true"></i></button>
                    </form>
                }
            </div>
        }
    </div>
    <div class="card-body d-flex align-items-center justify-content-between gap-2 flex-wrap">
        <span class="text-muted small">تعداد کل: @Model.Result.TotalCount</span>
        <nav>
            <ul class="pagination pagination-sm">
                @if (Model.PageNumber > 1) 
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="/Attributes/Index" asp-route-IncludeDeleted="@(Model.IncludeDeleted ? "true" : null)" asp-route-PageNumber="@(Model.PageNumber-1)">قبلی</a>
                    </li>
                }
                <li class="page-item active">
                    <span class="page-link">@Model.PageNumber</span>
                </li>
                @if (Model.PageNumber * 50L < Model.Result.TotalCount) 
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="/Attributes/Index" asp-route-IncludeDeleted="@(Model.IncludeDeleted ? "true" : null)" asp-route-PageNumber="@(Model.PageNumber+1)">بعدی</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
