@page
@model TIR.Web.Pages.Attributes.IndexModel
@{
    ViewData["Title"] = "مدیریت مشخصه ها";
}
<div class="toolbar">
    <div>
        <h2 class="section-title mb-1">فهرست مشخصه های داینامیک</h2>
        <p class="page-lead mb-0">عنوان، نوع، وضعیت و ترتیب نمایش مشخصه ها را مدیریت کنید.</p>
    </div>
    <a asp-page="/Attributes/Create" class="btn btn-primary">+ مشخصه جدید</a>
</div>
<div class="card">
    <div class="card-body pb-0">
        <form method="get" class="filter-bar mb-3">
            <input asp-for="Search" class="form-control flex-grow-1" placeholder="جستجو در کد یا عنوان مشخصه" />
            <div class="form-check">
                <input asp-for="IncludeDeleted" class="form-check-input" />
                <label asp-for="IncludeDeleted" class="form-check-label">نمایش حذف شده ها</label>
            </div>
            <button class="btn btn-outline-primary">جستجو</button>
        </form>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>کد</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>منبع</th>
                    <th>الزامی</th>
                    <th>ترتیب</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
        <tbody>

        @foreach (var item in Model.Result.Items)
        {
            <tr>
                <td class="mono">@item.AttributeCode</td>
                <td class="fw-semibold">@item.Title</td>
                <td>@Model.DataKindTitle(item.DataKind)</td>
                <td>@(item.SourceKind == 2 ? "فرمول" : "ورودی")</td>
                <td>@(item.IsRequired ? "بله" : "خیر")</td><td>@item.DisplayOrder</td>
                <td>
                    <span class="badge text-bg-@(item.IsDeleted ? "danger" : "success")">@(item.IsDeleted ? "حذف شده" : "فعال")</span>
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-2">
                        @if (!item.IsDeleted)
                        {
                            @if (item.SourceKind == 1 && item.DataKind == 8)
                            {
                                <a asp-page="/Attributes/Options" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">مدیریت گزینه ها</a>
                            }
                            <a asp-page="/Attributes/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">ویرایش</a>
                            <form method="post" asp-page-handler="SoftDelete" data-confirm="آیا از حذف منطقی این مشخصه مطمئن هستید؟">
                                <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                                <button class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Restore" data-confirm="مشخصه و مقدارهای وابسته بازیابی شوند؟">
                                <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                                <button class="btn btn-sm btn-outline-success">بازیابی</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Result.Items.Count == 0) 
    { 
        <div class="table-empty">مشخصه ای مطابق فیلتر وجود ندارد.</div>
    }
    </div>
    <div class="card-body d-flex align-items-center justify-content-between gap-2 flex-wrap">
        <span class="text-muted small">تعداد کل: @Model.Result.TotalCount</span>
        <nav>
            <ul class="pagination pagination-sm">
                @if (Model.PageNumber > 1) 
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="/Attributes/Index" asp-route-Search="@Model.Search" asp-route-IncludeDeleted="@Model.IncludeDeleted" asp-route-PageNumber="@(Model.PageNumber-1)">قبلی</a>
                    </li>
                }
                <li class="page-item active">
                    <span class="page-link">@Model.PageNumber</span>
                </li>
                @if (Model.PageNumber * 50L < Model.Result.TotalCount) 
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="/Attributes/Index" asp-route-Search="@Model.Search" asp-route-IncludeDeleted="@Model.IncludeDeleted" asp-route-PageNumber="@(Model.PageNumber+1)">بعدی</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
