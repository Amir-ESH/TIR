@* نمایش ساعت زنده ایران و تقویم خورشیدی ماه جاری *@
<div class="tir-iran-clock badge text-bg-light border px-3 py-2" id="tirIranClock">
    <button type="button" class="tir-iran-clock__date" id="tirIranDateTrigger"
            aria-label="نمایش تقویم خورشیدی" aria-expanded="false"
            aria-controls="tirIranCalendar">
        <span id="tirIranToday">در حال دریافت تاریخ...</span>
        <span class="tir-iran-clock__arrow" aria-hidden="true">▾</span>
    </button>

    <span class="tir-iran-clock__divider" aria-hidden="true"></span>
    <span class="tir-iran-clock__time" id="tirIranTime" dir="ltr" title="ساعت ایران">--:--:--</span>

    <div class="tir-iran-calendar shadow" id="tirIranCalendar"
         role="dialog" aria-label="تقویم ماه خورشیدی" aria-modal="false" hidden>
        <div id="tirIranCalendarContent"></div>
        <div class="tir-iran-calendar__footer">
            <button type="button" id="tirIranGoToToday" class="btn btn-sm btn-outline-primary">امروز</button>
            <button type="button" id="tirIranCloseCalendar" class="btn btn-sm btn-light">بستن</button>
        </div>
    </div>
</div>
