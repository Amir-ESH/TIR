@{
    var pageTitle = ViewData["Title"] as string ?? "سامانه مدیریت پرسنل";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@pageTitle | TIR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.rtl.min.css"
          rel="stylesheet" integrity="sha384-CfCrinSRH2IR6a4e6fy2q6ioOX7O6Mtm1L9vRvFZ1trBncWmMePhzvafv7oIcWiW" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/iran-clock.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a asp-page="/Index" class="brand" aria-label="صفحه اصلی">
                <span class="brand-mark">T</span>
                <span><strong>TIR</strong><small>مدیریت داینامیک پرسنل</small></span>
            </a>
            <div class="nav-caption">منو مدیریت سازمان</div>
            <nav class="side-nav" aria-label="منوی اصلی">
                <a asp-page="/Index"><span class="nav-symbol">▦</span> داشبورد</a>
                <a asp-page="/Employees/Index"><span class="nav-symbol">♙</span> کارمندان</a>
                <a asp-page="/Attributes/Index"><span class="nav-symbol">☷</span> مشخصه های داینامیک</a>
                <a asp-page="/Employees/Search"><span class="nav-symbol">⌕</span> جستجوی پیشرفته</a>
                <a asp-page="/Bulk/Index"><span class="nav-symbol">⇄</span> عملیات گروهی</a>
                <a href="/hangfire" target="_blank" rel="noopener"><span class="nav-symbol">◷</span> داشبورد Hangfire</a>
            </nav>
            <div class="sidebar-bottom"><span class="status-pulse"></span> نسخه MVP | مدل سازمانی</div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button type="button" class="btn btn-outline-secondary d-lg-none" id="menuToggle" aria-label="نمایش منو">☰</button>
                <div class="topbar-heading">
                    <span class="eyebrow">سامانه منابع انسانی</span>
                    <h1>@pageTitle</h1>
                </div>
                <div class="topbar-actions">
                    <partial name="_IranClock" />
                    <a asp-page="/Employees/Create" class="btn btn-primary btn-sm px-3">+ کارمند جدید</a>
                </div>
            </header>

            <main class="content-container" id="main-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        @success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                    </div>
                }
                @if (TempData["Error"] is string failure)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @failure
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">پروژه مدیریت منابع انسانی | نسخه ابتدایی</footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-4.0.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/iran-clock.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
