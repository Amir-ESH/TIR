@model UiField
@{
    string FieldName(string property) => $"{Model.Prefix}.{property}";
    var readonlyFormula = Model.SourceKind == 2;
}
<div class="dynamic-field" data-attribute-id="@Model.AttributeId" data-data-kind="@Model.DataKind">
    <input type="hidden" name="@FieldName("AttributeId")" value="@Model.AttributeId" />
    <input type="hidden" name="@FieldName("ExpectedRowVersion")" value="@Model.ExpectedRowVersion" class="js-rowversion" />
    <label class="form-label fw-semibold">
        @Model.Name
        @if (Model.IsRequired && !readonlyFormula)
        {
            <span class="text-danger">*</span>
        }
    </label>
    @if (readonlyFormula)
    {
        <div class="form-control bg-light-subtle d-flex align-items-center justify-content-between">
            <span>@(Model.RawValue ?? "هنوز محاسبه نشده")</span>
            <span class="badge text-bg-@Model.StatusColor">@Model.StatusText</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.CalculationErrorMessage))
        {
            <div class="text-danger small mt-1">@Model.CalculationErrorMessage</div>
        }
    }
    else if (Model.DataKind == 1)
    {
        <input class="form-control" name="@FieldName("RawValue")" value="@Model.RawValue" maxlength="1000" placeholder="متن را وارد کنید" />
    }
    else if (Model.DataKind == 2)
    {
        <input type="number" step="1" class="form-control" name="@FieldName("RawValue")" value="@Model.RawValue" placeholder="عدد صحیح" />
    }
    else if (Model.DataKind == 3)
    {
        <input type="number" step="0.001" class="form-control" name="@FieldName("RawValue")" value="@Model.RawValue" placeholder="0.000" />
    }
    else if (Model.DataKind == 4)
    {
        <div class="input-group">
            <input class="form-control js-jalali-date" name="@FieldName("RawValue")" value="@Model.RawValue" placeholder="1405/08/01" autocomplete="off" />
            <span class="input-group-text">خورشیدی</span>
        </div>
    }
    else if (Model.DataKind == 5)
    {
        <input type="text" readonly class="form-control js-tir-time" name="@FieldName("RawValue")" value="@Model.RawValue" placeholder="برای انتخاب ساعت کلیک کنید" autocomplete="off" aria-label="انتخاب ساعت" />
    }
    else if (Model.DataKind == 6)
    {
        <input class="form-control js-jalali-datetime" name="@FieldName("RawValue")" value="@Model.RawValue" placeholder="1405/08/01 07:00" autocomplete="off" />
        <div class="form-text">تاریخ و ساعت به وقت ایران</div>
    }
    else if (Model.DataKind == 7)
    {
        @if (!Model.IsRequired)
        {
            <div class="form-check mb-2">
                <input class="form-check-input js-bool-set" type="checkbox" name="@FieldName("BooleanIsSet")" value="true" checked="@Model.BooleanIsSet" />
                <label class="form-check-label">ثبت مقدار برای این مشخصه</label>
            </div>
        }
        <div class="form-check form-switch">
            <input class="form-check-input js-bool-check" type="checkbox" name="@FieldName("BooleanChecked")" value="true" checked="@Model.BooleanChecked" />
            <label class="form-check-label">بله / خیر</label>
        </div>
    }
    else if (Model.DataKind == 8)
    {
        <select class="form-select" name="@FieldName("RawValue")">
            <option value="">یک گزینه انتخاب کنید</option>
            @foreach (var option in Model.Options)
            {
                <option value="@option.Id" selected="@(Model.RawValue == option.Id.ToString())">@option.Title</option>
            }
        </select>
    }
    @if (!readonlyFormula)
    {
        <div class="form-text">کد: @Model.Code</div>
    }
</div>
